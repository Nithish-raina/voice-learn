PORT=3000

# Database (Neon, Supabase, or any PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname

# Redis (Upstash or any Redis instance)
REDIS_URL=redis://default:password@host:port

# Auth
JWT_SECRET=replace-with-a-random-string
JWT_REFRESH_SECRET=replace-with-another-random-string

# Deepgram — speech-to-text
DEEPGRAM_API_KEY=

# Anthropic — powers the analysis pipeline
ANTHROPIC_API_KEY=

# AWS S3 — stores recorded audio files
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS=
AWS_BUCKET_NAME=voice-learn
AWS_REGION=ap-south-1

# Pinecone — vector search for chat feature
PINECONE_API_KEY=
PINECONE_INDEX=voice-learn

# Frontend URL — used for CORS
CLIENT_URL=http://localhost:5173

# Optional — only needed if you want Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — not used in core flow
OPENAI_API_KEY=
HF_API_KEY=
